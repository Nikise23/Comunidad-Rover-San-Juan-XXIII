# Opción 1 (recomendada): una sola variable para Neon / Render
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Opción 2: variables sueltas (local o sin DATABASE_URL)
# PORT=3000
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=rover_fundraising
# DB_SSL=false

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Misma URL que uses en el navegador (CORS). 127.0.0.1 y localhost cuentan distinto.
# JWT_SECRET=...   # obligatorio razonable en producción
# INITIAL_ADMIN_USERNAME=rover_admin
# INITIAL_ADMIN_PASSWORD=RoverSJ23!2026
# ALLOW_PUBLIC_REGISTER=true  # registro desde la pantalla de login (opcional)
